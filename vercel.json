{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/krx/stocks/search",
      "destination": "/api/krx/stocks"
    },
    {
      "source": "/api/krx/stocks/:code",
      "destination": "/api/krx/stocks?code=:code"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
